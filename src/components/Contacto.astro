---
// Contacto.astro
---
<section id="contacto" class="py-24 bg-gradient-to-br from-blue-50 to-white relative overflow-hidden border-t border-gray-100">
    <!-- Grid background decoration -->
    <div class="absolute inset-0 opacity-40 bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    
    <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-5xl mx-auto bg-white border border-gray-100 p-10 md:p-16 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                
                <div class="pr-0 md:pr-8">
                    <h2 class="text-4xl md:text-5xl font-heading font-black mb-6 text-plai-dark">Hablemos</h2>
                    <p class="text-lg text-gray-600 font-body mb-8 leading-relaxed">
                        Si tienes procesos repetitivos que consumen tiempo, conversemos. Primera reunión sin costo para entender qué necesitas. Propuesta clara con alcances y plazos. Sin letra chica.
                    </p>
                    
                    <ul class="space-y-4 mb-4 font-body text-gray-600 font-medium">
                        <li class="flex items-center gap-3">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-100 text-plai-primary flex items-center justify-center text-sm">✓</span> Primera reunión sin costo
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-100 text-plai-primary flex items-center justify-center text-sm">✓</span> Soporte técnico directo con los desarrolladores
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-100 text-plai-primary flex items-center justify-center text-sm">✓</span> Equipo técnico (no agencia de marketing)
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-100 text-plai-primary flex items-center justify-center text-sm">✓</span> Especialistas en Industria Financiera
                        </li>
                        <li class="flex items-center gap-3">
                            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-100 text-plai-primary flex items-center justify-center text-sm">✓</span> Conocimiento en infraestructura crítica
                        </li>
                    </ul>
                </div>
                
                <div class="bg-plai-primary rounded-3xl p-8 md:p-10 text-white shadow-xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-white opacity-10 rounded-full blur-2xl"></div>
                    <div class="absolute bottom-0 left-0 -mb-10 -ml-10 w-40 h-40 bg-white opacity-10 rounded-full blur-2xl"></div>

                    <h3 class="text-2xl font-bold font-heading mb-6 relative z-10">Inicia tu automatización</h3>
                    <form id="contactForm" class="space-y-4 relative z-10" novalidate>
                        <div>
                            <label for="contact-name" class="block text-sm font-medium mb-1">Nombre</label>
                            <input type="text" id="contact-name" name="name" required minlength="2"
                                class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/40 transition-all"
                                placeholder="Tu nombre" />
                        </div>
                        <div>
                            <label for="contact-email" class="block text-sm font-medium mb-1">Email</label>
                            <input type="email" id="contact-email" name="email" required
                                class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/40 transition-all"
                                placeholder="tu@empresa.cl" />
                        </div>
                        <div>
                            <label for="contact-message" class="block text-sm font-medium mb-1">Mensaje</label>
                            <textarea id="contact-message" name="message" required minlength="10" rows="3"
                                class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-white/40 transition-all resize-none"
                                placeholder="Cuéntanos qué necesitas automatizar"></textarea>
                        </div>
                        <button type="submit" id="contactSubmit"
                            class="bg-white hover:bg-gray-100 text-plai-primary w-full py-4 rounded-xl font-bold text-lg transition-all shadow-lg hover:shadow-xl active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed">
                            Contactar a Ventas
                        </button>
                    </form>
                    <div id="contactSuccess" class="hidden relative z-10 text-center py-8">
                        <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <p class="text-xl font-bold font-heading mb-2">¡Mensaje enviado!</p>
                        <p class="text-white/80 text-sm">Te contactaremos a la brevedad.</p>
                    </div>
                    <div id="contactError" class="hidden relative z-10 mt-4 p-3 bg-red-500/20 border border-red-300/30 rounded-xl text-sm text-center">
                        Hubo un error al enviar. Intenta de nuevo o escríbenos a <a href="mailto:plai@plai.cl" class="underline">plai@plai.cl</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script>
    // TODO: Reemplazar con la URL real de la Cloud Function
    const CONTACT_ENDPOINT = '';

    const form = document.getElementById('contactForm') as HTMLFormElement;
    const btn = document.getElementById('contactSubmit') as HTMLButtonElement;
    const successMsg = document.getElementById('contactSuccess')!;
    const errorMsg = document.getElementById('contactError')!;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg.classList.add('hidden');

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const data = Object.fromEntries(new FormData(form));

        if (!CONTACT_ENDPOINT) {
            // Fallback mientras no haya Cloud Function: mailto
            const subject = encodeURIComponent('Contacto desde plai.cl');
            const body = encodeURIComponent(`Nombre: ${data.name}\nEmail: ${data.email}\n\n${data.message}`);
            window.location.href = `mailto:plai@plai.cl?subject=${subject}&body=${body}`;
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Enviando...';

        try {
            const res = await fetch(CONTACT_ENDPOINT, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });
            if (!res.ok) throw new Error('Error en el servidor');
            form.classList.add('hidden');
            successMsg.classList.remove('hidden');
        } catch {
            errorMsg.classList.remove('hidden');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Contactar a Ventas';
        }
    });
</script>
