---
// Contacto.astro
---
<section id="contacto" class="py-24 bg-gradient-to-br from-blue-50 to-white relative overflow-hidden border-t border-gray-100">
    <div class="absolute inset-0 opacity-30 bg-[linear-gradient(to_right,#e5e7eb_1px,transparent_1px),linear-gradient(to_bottom,#e5e7eb_1px,transparent_1px)] bg-[size:24px_24px]"></div>

    <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-5xl mx-auto bg-white border border-gray-100 p-10 md:p-14 rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.06)]">
            <div class="grid md:grid-cols-2 gap-12 items-start">

                <!-- Left: value proposition -->
                <div>
                    <p class="text-xs font-body font-bold uppercase tracking-widest text-plai-primary mb-3">Demo gratuita</p>
                    <h2 class="text-4xl md:text-5xl font-heading font-black mb-5 text-plai-dark leading-tight">Mira la plataforma en acción</h2>
                    <p class="text-gray-500 font-body text-base leading-relaxed mb-8">
                        30 minutos. Sin compromiso. Te mostramos el backoffice real de GEMA y ERI funcionando con datos de clientes actuales.
                    </p>

                    <!-- Demo benefits -->
                    <ul class="space-y-4 mb-8">
                        {[
                            {
                                icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3"/>`,
                                title: "Demo del backoffice real",
                                desc: "Ves el panel de GEMA con publicaciones reales, calendarios y métricas."
                            },
                            {
                                icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/>`,
                                title: "ERI en vivo",
                                desc: "Si tienes WhatsApp Business, conectamos ERI en tiempo real durante la demo."
                            },
                            {
                                icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z"/>`,
                                title: "Precio fijo desde el primer día",
                                desc: "Sin cotizaciones. El plan que eliges incluye acceso inmediato al backoffice."
                            },
                        ].map(item => (
                            <li class="flex items-start gap-4">
                                <div class="w-9 h-9 rounded-xl bg-plai-primary/10 flex items-center justify-center flex-shrink-0 mt-0.5">
                                    <svg aria-hidden="true" class="w-4.5 h-4.5 text-plai-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" set:html={item.icon}/>
                                </div>
                                <div>
                                    <p class="font-heading font-bold text-plai-dark text-sm mb-0.5">{item.title}</p>
                                    <p class="text-gray-500 font-body text-sm leading-relaxed">{item.desc}</p>
                                </div>
                            </li>
                        ))}
                    </ul>

                    <p class="text-gray-400 font-body text-xs">¿Prefieres escribirnos directo? <a href="mailto:plai@plai.cl" class="text-plai-primary underline underline-offset-2">plai@plai.cl</a></p>
                </div>

                <!-- Right: form -->
                <div class="bg-plai-primary rounded-3xl p-8 md:p-10 text-white shadow-xl relative overflow-hidden">
                    <div class="absolute top-0 right-0 -mt-10 -mr-10 w-40 h-40 bg-white opacity-[0.07] rounded-full blur-2xl pointer-events-none"></div>
                    <div class="absolute bottom-0 left-0 -mb-10 -ml-10 w-40 h-40 bg-white opacity-[0.07] rounded-full blur-2xl pointer-events-none"></div>

                    <h3 class="text-xl font-bold font-heading mb-1 relative z-10">Agenda tu demo gratuita</h3>
                    <p class="text-white/60 text-sm font-body mb-6 relative z-10">Responderemos en menos de 24 horas. <span class="text-white/40 text-xs">(<span class="text-plai-cyan/70">*</span> requerido)</span></p>

                    <form id="contactForm" class="space-y-3.5 relative z-10" novalidate>
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label for="contact-name" class="block text-xs font-medium mb-1 text-white/80">Nombre <span class="text-plai-cyan/80" aria-hidden="true">*</span></label>
                                <input type="text" id="contact-name" name="name" required minlength="2"
                                    class="w-full px-3.5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/40 transition-all text-sm"
                                    placeholder="Tu nombre" />
                            </div>
                            <div>
                                <label for="contact-empresa" class="block text-xs font-medium mb-1 text-white/80">Empresa</label>
                                <input type="text" id="contact-empresa" name="empresa"
                                    class="w-full px-3.5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/40 transition-all text-sm"
                                    placeholder="Nombre del negocio" />
                            </div>
                        </div>
                        <div>
                            <label for="contact-email" class="block text-xs font-medium mb-1 text-white/80">Email <span class="text-plai-cyan/80" aria-hidden="true">*</span></label>
                            <input type="email" id="contact-email" name="email" required
                                class="w-full px-3.5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/40 transition-all text-sm"
                                placeholder="tu@empresa.cl" />
                        </div>
                        <div>
                            <label for="contact-plan" class="block text-xs font-medium mb-1 text-white/80">¿Qué te interesa?</label>
                            <select id="contact-plan" name="plan"
                                class="w-full px-3.5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white focus:outline-none focus:ring-2 focus:ring-white/40 transition-all text-sm appearance-none cursor-pointer">
                                <option value="" class="text-plai-dark bg-white">Selecciona un producto</option>
                                <option value="gema" class="text-plai-dark bg-white">GEMA — Marketing Automatizado</option>
                                <option value="eri" class="text-plai-dark bg-white">ERI — Agente IA de Ventas</option>
                                <option value="suite" class="text-plai-dark bg-white">Plan PLAI Suite (GEMA + ERI)</option>

                                <option value="none" class="text-plai-dark bg-white">Todavía no lo tengo claro</option>
                            </select>
                        </div>
                        <div>
                            <label for="contact-message" class="block text-xs font-medium mb-1 text-white/80">Cuéntanos brevemente</label>
                            <textarea id="contact-message" name="message" rows="3"
                                class="w-full px-3.5 py-2.5 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:ring-2 focus:ring-white/40 transition-all resize-none text-sm"
                                placeholder="¿Qué proceso quieres automatizar?"></textarea>
                        </div>
                        <button type="submit" id="contactSubmit"
                            class="bg-white hover:bg-plai-cyan text-plai-primary hover:text-plai-black w-full py-3.5 rounded-xl font-bold text-base transition-all shadow-lg hover:shadow-xl active:scale-95 disabled:opacity-60 disabled:cursor-not-allowed">
                            Solicitar demo →
                        </button>
                    </form>

                    <div id="contactSuccess" class="hidden relative z-10 text-center py-8">
                        <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center mx-auto mb-4">
                            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        </div>
                        <p class="text-xl font-bold font-heading mb-2">¡Listo!</p>
                        <p class="text-white/70 text-sm">Te contactamos en menos de 24 horas para coordinar la demo.</p>
                    </div>
                    <div id="contactError" class="hidden relative z-10 mt-4 p-3 bg-red-500/20 border border-red-300/30 rounded-xl text-sm text-center">
                        Error al enviar. Escríbenos a <a href="mailto:plai@plai.cl" class="underline">plai@plai.cl</a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script>
    const CONTACT_ENDPOINT = '';

    const form = document.getElementById('contactForm') as HTMLFormElement;
    const btn = document.getElementById('contactSubmit') as HTMLButtonElement;
    const successMsg = document.getElementById('contactSuccess')!;
    const errorMsg = document.getElementById('contactError')!;

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorMsg.classList.add('hidden');

        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        const data = Object.fromEntries(new FormData(form));

        if (!CONTACT_ENDPOINT) {
            const subject = encodeURIComponent('Demo PLAI — ' + (data.plan || 'consulta'));
            const body = encodeURIComponent(
                `Nombre: ${data.name}\nEmpresa: ${data.empresa || '—'}\nEmail: ${data.email}\nProducto: ${data.plan || '—'}\n\n${data.message}`
            );
            window.location.href = `mailto:plai@plai.cl?subject=${subject}&body=${body}`;
            return;
        }

        btn.disabled = true;
        btn.textContent = 'Enviando...';

        try {
            const res = await fetch(CONTACT_ENDPOINT, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data),
            });
            if (!res.ok) throw new Error(`Error al enviar formulario: ${res.status} ${res.statusText}`);
            form.classList.add('hidden');
            successMsg.classList.remove('hidden');
        } catch {
            errorMsg.classList.remove('hidden');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Solicitar demo →';
        }
    });
</script>
