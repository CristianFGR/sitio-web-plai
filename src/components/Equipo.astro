---
// Equipo.astro
---
<section id="equipo" class="py-24 bg-gray-50">
    <div class="container mx-auto px-4">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-5xl font-heading font-bold text-plai-dark mb-4">Nuestro Equipo</h2>
            <p class="text-lg text-gray-600 font-body max-w-2xl mx-auto">
                Profesionales con experiencia real en industrias que importan.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 max-w-5xl mx-auto">
            <!-- Ricardo -->
            <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all text-center border border-gray-100">
                <div class="w-20 h-20 bg-plai-primary text-white rounded-full flex items-center justify-center mx-auto mb-5 font-heading font-black text-2xl">
                    RM
                </div>
                <h3 class="text-xl font-bold text-plai-dark font-heading mb-3">Ricardo</h3>
                <p class="text-gray-600 font-body text-sm leading-relaxed">
                    Ex Gerente de Marketing Cencosud. Ex subgerente de producto de Transbank. Ingeniero Industrial PUC.
                </p>
            </div>

            <!-- Rodrigo -->
            <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all text-center border border-gray-100">
                <div class="w-20 h-20 bg-plai-accent text-white rounded-full flex items-center justify-center mx-auto mb-5 font-heading font-black text-2xl">
                    RM
                </div>
                <h3 class="text-xl font-bold text-plai-dark font-heading mb-3">Rodrigo</h3>
                <p class="text-gray-600 font-body text-sm leading-relaxed">
                    Consultor de Tecnología y Agilidad. Experiencia en Banca, Seguros, Fintech & Retail. Diplomado en Inteligencia Artificial & Open Finance.
                </p>
            </div>

            <!-- William -->
            <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all text-center border border-gray-100">
                <div class="w-20 h-20 bg-purple-600 text-white rounded-full flex items-center justify-center mx-auto mb-5 font-heading font-black text-2xl">
                    WS
                </div>
                <h3 class="text-xl font-bold text-plai-dark font-heading mb-3">William</h3>
                <p class="text-gray-600 font-body text-sm leading-relaxed">
                    Quality Assurance Lead CCLA. Ingeniero de Software - Banco Falabella. Experiencia en Banca, Seguros y Medios de pago.
                </p>
            </div>

            <!-- Felix -->
            <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all text-center border border-gray-100">
                <div class="w-20 h-20 bg-plai-secondary text-white rounded-full flex items-center justify-center mx-auto mb-5 font-heading font-black text-2xl">
                    FX
                </div>
                <h3 class="text-xl font-bold text-plai-dark font-heading mb-3">Felix</h3>
                <p class="text-gray-600 font-body text-sm leading-relaxed">
                    Líder Técnico de Desarrollo. Full Stack Developer. Ingeniero de Software. Experiencia en pagos y retail.
                </p>
            </div>
        </div>
    </div>
</section>
