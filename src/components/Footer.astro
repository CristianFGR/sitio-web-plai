---
// Footer.astro
---
<footer class="bg-plai-dark text-white pt-14 pb-8 border-t border-white/[0.06]">
    <div class="container mx-auto px-4">

        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">

            <!-- Brand column -->
            <div class="col-span-1 md:col-span-2">
                <a href={import.meta.env.BASE_URL} class="inline-block mb-5">
                    <img
                        src={import.meta.env.BASE_URL + "images/logoplai_2.webp"}
                        alt="PLAI — Plataforma SaaS de automatización con IA"
                        loading="lazy"
                        class="h-8 w-auto filter grayscale brightness-200"
                    />
                </a>
                <p class="text-gray-400 font-body text-sm leading-relaxed max-w-xs mb-5">
                    Plataforma SaaS chilena que automatiza el marketing, las ventas y la atención al cliente de PYMEs y eCommerce — desde un backoffice propio.
                </p>
                <a href="mailto:plai@plai.cl" class="inline-flex items-center gap-2 text-gray-400 hover:text-white transition-colors duration-200 font-body text-sm mb-6 group">
                    <svg aria-hidden="true" class="w-4 h-4 flex-shrink-0 text-plai-primary group-hover:text-white transition-colors duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
                    </svg>
                    plai@plai.cl
                </a>
                <div class="flex gap-4">
                    <a href="https://www.linkedin.com/company/plai-cl/" target="_blank" rel="noopener noreferrer" aria-label="PLAI en LinkedIn" class="text-gray-500 hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                    <a href="https://www.instagram.com/plai.cl/" target="_blank" rel="noopener noreferrer" aria-label="PLAI en Instagram" class="text-gray-500 hover:text-white transition-colors duration-200">
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                </div>
            </div>

            <!-- Plataforma links -->
            <div>
                <h4 class="font-heading font-bold text-sm uppercase tracking-widest text-white mb-5">Plataforma</h4>
                <ul class="space-y-3 font-body text-sm">
                    <li><a href="#plataforma" class="text-gray-400 hover:text-white transition-colors duration-200">Backoffice</a></li>
                    <li><a href="#productos" class="text-gray-400 hover:text-white transition-colors duration-200">Productos</a></li>
                    <li><a href="#pricing" class="text-gray-400 hover:text-white transition-colors duration-200">Planes</a></li>
                    <li><a href="#contacto" class="text-gray-400 hover:text-white transition-colors duration-200">Solicitar demo</a></li>
                </ul>
            </div>

            <!-- Empresa + Legal links -->
            <div>
                <h4 class="font-heading font-bold text-sm uppercase tracking-widest text-white mb-5">Empresa</h4>
                <ul class="space-y-3 font-body text-sm mb-8">
                    <li><a href="#equipo" class="text-gray-400 hover:text-white transition-colors duration-200">Equipo</a></li>
                    <li><a href="#contacto" class="text-gray-400 hover:text-white transition-colors duration-200">Contacto</a></li>
                </ul>
                <h4 class="font-heading font-bold text-sm uppercase tracking-widest text-white mb-5">Legal</h4>
                <ul class="space-y-3 font-body text-sm">
                    <li><a href={import.meta.env.BASE_URL + "terminos-y-condiciones"} class="text-gray-400 hover:text-white transition-colors duration-200">Términos y Condiciones</a></li>
                    <li><a href={import.meta.env.BASE_URL + "politica-de-privacidad"} class="text-gray-400 hover:text-white transition-colors duration-200">Política de Privacidad</a></li>
                </ul>
            </div>

        </div>

        <!-- Bottom bar -->
        <div class="border-t border-white/[0.06] pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-gray-500 font-body text-xs">
            <p>&copy; {new Date().getFullYear()} PLAI. Todos los derechos reservados.</p>
            <p class="text-gray-600">Hecho en Chile 🇨🇱 · Infraestructura en Google Cloud Platform</p>
        </div>

    </div>
</footer>
