---
// Header.astro
---
<header class="w-full fixed top-0 z-50 transition-all duration-300" id="mainHeader">
    <div class="container mx-auto px-4 py-4 md:py-5 flex justify-between items-center relative z-50">
        <!-- Logo -->
        <a href={import.meta.env.BASE_URL} class="flex flex-row items-center gap-2">
            <img src={import.meta.env.BASE_URL + "images/cropped-LogoPlai_Black.webp"} alt="PLAI — Automatización IA para eCommerce y PYMEs" width="500" height="200" class="h-6 md:h-8 w-auto relative z-10 header-logo-dark" />
            <img src={import.meta.env.BASE_URL + "images/logoplai_2.webp"} alt="PLAI — Automatización IA para eCommerce y PYMEs" width="825" height="324" class="h-6 md:h-8 w-auto relative z-10 header-logo-light hidden" />
        </a>

        <!-- Desktop Navbar -->
        <nav class="hidden lg:flex gap-8 font-body font-medium text-[15px]" id="desktopNav">
            <a href={import.meta.env.BASE_URL} class="text-white/80 hover:text-white transition-colors nav-link">Inicio</a>
            <a href="#plataforma" class="text-white/80 hover:text-white transition-colors nav-link">Plataforma</a>
            <a href="#productos" class="text-white/80 hover:text-white transition-colors nav-link">Productos</a>
            <a href="#pricing" class="text-white/80 hover:text-white transition-colors nav-link">Planes</a>
            <a href="#contacto" class="text-white hover:text-plai-primary transition-colors font-bold nav-link">Contacto</a>
        </nav>

        <!-- Mobile Menu Toggle Button -->
        <div class="lg:hidden">
            <button id="menu-toggle" class="text-white p-2 menu-toggle-btn rounded-lg focus:outline-none focus:ring-2 focus:ring-white/50 focus:ring-offset-2 focus:ring-offset-transparent" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            </button>
        </div>
    </div>
</header>

<!-- Mobile Menu Overlay -->
<div id="mobile-menu" class="fixed inset-0 bg-white z-[60] transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col justify-center items-center" aria-hidden="true">
    <!-- Botón cerrar dentro del overlay para evitar conflictos de z-index con el header -->
    <button id="menu-close" class="absolute top-4 right-4 text-plai-dark p-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-plai-primary/50 focus:ring-offset-2" aria-label="Cerrar menú" tabindex="-1">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
    <nav class="flex flex-col gap-6 font-body font-medium text-2xl text-plai-dark text-center">
        <a href={import.meta.env.BASE_URL} class="mobile-link hover:text-plai-primary transition-colors" tabindex="-1">Inicio</a>
        <a href="#plataforma" class="mobile-link hover:text-plai-primary transition-colors" tabindex="-1">Plataforma</a>
        <a href="#productos" class="mobile-link hover:text-plai-primary transition-colors" tabindex="-1">Productos</a>
        <a href="#pricing" class="mobile-link hover:text-plai-primary transition-colors" tabindex="-1">Planes</a>
        <a href="#contacto" class="mobile-link bg-plai-primary text-white px-8 py-3 rounded-full mt-4" tabindex="-1">Contacto</a>
    </nav>
</div>

<script>
    const menuToggle = document.getElementById('menu-toggle');
    const menuClose = document.getElementById('menu-close');
    const mobileMenu = document.getElementById('mobile-menu');
    const header = document.getElementById('mainHeader');
    const mobileLinks = document.querySelectorAll('.mobile-link');
    const navLinks = document.querySelectorAll('.nav-link');
    const logoDark = document.querySelector('.header-logo-dark');
    const logoLight = document.querySelector('.header-logo-light');
    const menuBtn = document.querySelector('.menu-toggle-btn');

    let isMenuOpen = false;

    function toggleMenu() {
        isMenuOpen = !isMenuOpen;
        menuToggle?.setAttribute('aria-expanded', String(isMenuOpen));
        menuToggle?.setAttribute('aria-label', isMenuOpen ? 'Cerrar menú' : 'Abrir menú');
        mobileMenu?.setAttribute('aria-hidden', String(!isMenuOpen));
        if (isMenuOpen) {
            mobileMenu?.classList.remove('translate-x-full');
            document.body.style.overflow = 'hidden';
            mobileLinks.forEach(link => link.setAttribute('tabindex', '0'));
            menuClose?.setAttribute('tabindex', '0');
            menuToggle?.setAttribute('tabindex', '-1');
            if (menuClose instanceof HTMLElement) {
                menuClose.focus();
            }
        } else {
            mobileMenu?.classList.add('translate-x-full');
            document.body.style.overflow = '';
            mobileLinks.forEach(link => link.setAttribute('tabindex', '-1'));
            menuClose?.setAttribute('tabindex', '-1');
            menuToggle?.setAttribute('tabindex', '0');
            // Restore based on scroll
            handleScroll();
        }
    }

    function handleScroll() {
        if (isMenuOpen) return;
        const scrolled = window.scrollY > 50;
        if (scrolled) {
            header?.classList.add('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
            logoDark?.classList.remove('hidden');
            logoLight?.classList.add('hidden');
            menuBtn?.classList.remove('text-white');
            menuBtn?.classList.add('text-plai-dark');
            navLinks.forEach(link => {
                link.classList.remove('text-white/80', 'text-white', 'hover:text-white');
                link.classList.add('text-plai-dark/70', 'hover:text-plai-primary');
                if (link.classList.contains('font-bold')) {
                    link.classList.add('text-plai-dark');
                }
            });
        } else {
            header?.classList.remove('bg-white/95', 'backdrop-blur-md', 'shadow-sm');
            logoDark?.classList.add('hidden');
            logoLight?.classList.remove('hidden');
            menuBtn?.classList.add('text-white');
            menuBtn?.classList.remove('text-plai-dark');
            navLinks.forEach(link => {
                link.classList.add('text-white/80', 'hover:text-white');
                link.classList.remove('text-plai-dark/70', 'hover:text-plai-primary', 'text-plai-dark');
                if (link.classList.contains('font-bold')) {
                    link.classList.add('text-white');
                }
            });
        }
    }

    menuToggle?.addEventListener('click', toggleMenu);
    menuClose?.addEventListener('click', toggleMenu);

    mobileLinks.forEach(link => {
        link.addEventListener('click', () => {
            if (isMenuOpen) toggleMenu();
        });
    });

    // Close menu on Escape key press and handle focus trap
    document.addEventListener('keydown', (e) => {
        if (!isMenuOpen) return;

        if (e.key === 'Escape') {
            toggleMenu();
            if (menuToggle instanceof HTMLElement) {
                menuToggle.focus();
            }
            return;
        }

        if (e.key === 'Tab') {
            const activeEl = document.activeElement;
            const lastLink = mobileLinks[mobileLinks.length - 1];

            if (e.shiftKey) { // Shift + Tab
                if (activeEl === menuClose) {
                    if (lastLink instanceof HTMLElement) {
                        lastLink.focus();
                        e.preventDefault();
                    }
                }
            } else { // Tab
                if (activeEl === lastLink) {
                    if (menuClose instanceof HTMLElement) {
                        menuClose.focus();
                        e.preventDefault();
                    }
                }
            }
        }
    });

    // Close menu when clicking outside of the navigation content
    mobileMenu?.addEventListener('click', (e) => {
        if (e.target === mobileMenu) {
            toggleMenu();
        }
    });

    // Initial state: light logo visible, dark hidden
    logoDark.classList.add('hidden');
    logoLight.classList.remove('hidden');

    let wasScrolled = false;
    function onScroll() {
        const scrolled = window.scrollY > 50;
        if (scrolled === wasScrolled) return;
        wasScrolled = scrolled;
        handleScroll();
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    handleScroll();
</script>
