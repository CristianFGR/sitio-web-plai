---
// Hero.astro
---
<section class="relative w-full min-h-screen flex items-center overflow-hidden hero-bg">

    <!-- Radial gradient accents -->
    <div class="absolute top-0 right-0 w-[700px] h-[700px] bg-[radial-gradient(circle,rgba(0,100,255,0.12)_0%,transparent_65%)] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[radial-gradient(circle,rgba(0,201,183,0.08)_0%,transparent_65%)] pointer-events-none"></div>
    <div class="absolute top-[40%] left-[35%] w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(124,58,237,0.05)_0%,transparent_60%)] pointer-events-none"></div>

    <!-- Subtle grid pattern -->
    <div class="absolute inset-0 opacity-[0.03]" style="background-image: linear-gradient(rgba(255,255,255,.1) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.1) 1px, transparent 1px); background-size: 60px 60px;"></div>

    <div class="container mx-auto px-4 pt-28 pb-16 md:pt-0 md:pb-0">
        <div class="grid lg:grid-cols-[1fr_1.1fr] gap-10 lg:gap-12 items-center relative z-20">

            <!-- Left Column: Copy -->
            <div class="flex flex-col items-start">
                <!-- Animated badge -->
                <div class="hero-enter-1 inline-flex items-center gap-2.5 bg-white/[0.04] border border-white/[0.08] rounded-full px-5 py-2.5 mb-8 hover:bg-white/[0.07] hover:border-white/[0.15] transition-all duration-300 cursor-default">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-plai-cyan opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-plai-cyan"></span>
                    </span>
                    <span class="text-white/60 font-body text-sm tracking-wide">Plataforma SaaS · Automatización con IA</span>
                </div>

                <h1 class="hero-enter-2 text-[2.75rem] md:text-[3.5rem] lg:text-[4rem] font-heading font-black text-white mb-6 leading-[1.08] tracking-tight">
                    La plataforma que <span class="bg-gradient-to-r from-plai-primary to-plai-secondary bg-clip-text text-transparent">automatiza</span> <br class="hidden sm:block" />
                    tu crecimiento
                </h1>

                <p class="hero-enter-3 text-base md:text-lg text-white/50 font-body mb-10 max-w-md leading-relaxed">
                    Publica contenido, atiende clientes y optimiza tus pagos — todo desde un backoffice propio. Sin código. Sin agencia. 100% self-serve.
                </p>

                <div class="hero-enter-4 flex flex-wrap gap-4 mb-12">
                    <a href="#plataforma" class="group relative bg-plai-primary text-white px-8 py-3.5 rounded-full font-bold text-base shadow-[0_0_30px_rgba(0,100,255,0.3)] transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_0_40px_rgba(0,100,255,0.45)] overflow-hidden">
                        <span class="relative z-10">Ver la plataforma</span>
                        <div class="absolute inset-0 bg-gradient-to-r from-plai-primary to-plai-secondary opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    </a>
                    <a href="#contacto" class="border border-white/15 hover:bg-white/[0.06] hover:border-white/25 text-white/80 hover:text-white px-8 py-3.5 rounded-full font-medium text-base transition-all duration-300 hover:-translate-y-0.5">
                        Solicitar demo
                    </a>
                </div>

                <!-- Stats row -->
                <div class="hero-enter-5 flex items-center gap-8 pt-8 border-t border-white/[0.06] w-full">
                    <div class="group cursor-default">
                        <p class="text-2xl font-heading font-black text-white group-hover:text-plai-primary transition-colors duration-300">24/7</p>
                        <p class="text-white/55 font-body text-xs mt-1">Siempre activo</p>
                    </div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div class="group cursor-default">
                        <p class="text-2xl font-heading font-black text-plai-cyan group-hover:scale-110 transition-transform duration-300 origin-left">847+</p>
                        <p class="text-white/55 font-body text-xs mt-1">Posts publicados</p>
                    </div>
                    <div class="w-px h-10 bg-white/10"></div>
                    <div class="group cursor-default">
                        <p class="text-2xl font-heading font-black text-plai-magenta group-hover:scale-110 transition-transform duration-300 origin-left">94%</p>
                        <p class="text-white/55 font-body text-xs mt-1">Tasa de respuesta</p>
                    </div>
                </div>
            </div>

            <!-- Right Column: Hero Image + Live Activity Widget -->
            <div class="hero-enter-img relative w-full mt-4 lg:mt-0 flex flex-col items-center justify-center gap-3">
                <!-- Glow behind image -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[90%] h-[90%] bg-gradient-to-br from-plai-primary/20 via-plai-cyan/10 to-plai-purple/15 rounded-full blur-[100px] pointer-events-none animate-glow"></div>

                <!-- Main image — real GEMA backoffice with browser chrome -->
                <div class="relative z-10 w-full max-w-[580px]">
                    <div class="rounded-2xl overflow-hidden shadow-[0_25px_80px_rgba(0,0,0,0.55)] border border-white/[0.08]">
                        <!-- Browser chrome -->
                        <div class="bg-[#1a1a2e] flex items-center gap-2 px-4 py-2.5 border-b border-white/[0.06]">
                            <span class="w-2.5 h-2.5 rounded-full bg-red-500/70"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/70"></span>
                            <span class="w-2.5 h-2.5 rounded-full bg-green-500/70"></span>
                            <div class="flex-1 mx-3 bg-white/[0.06] rounded-md px-3 py-1 flex items-center gap-2">
                                <svg aria-hidden="true" class="w-3 h-3 text-white/30 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                                <span class="text-white/35 text-[10px] font-body">gema-bo-plai.web.app</span>
                            </div>
                        </div>
                        <div class="relative">
                            <img
                                src={import.meta.env.BASE_URL + "images/gema-dashboard.webp"}
                                alt="Backoffice GEMA — dashboard de publicaciones automatizadas"
                                width="1440"
                                height="900"
                                fetchpriority="high"
                                class="w-full"
                            />
                            <div class="absolute inset-0 bg-gradient-to-t from-plai-black/40 via-transparent to-transparent pointer-events-none"></div>
                        </div>
                    </div>
                </div>

                <!-- Live activity strip -->
                <div class="relative z-10 w-full max-w-[580px] bg-plai-black/70 backdrop-blur-xl border border-white/10 rounded-2xl px-5 py-4 shadow-2xl">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="relative flex h-2 w-2">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-plai-cyan opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2 w-2 bg-plai-cyan"></span>
                        </span>
                        <span class="text-plai-cyan text-xs font-bold font-body uppercase tracking-widest">Plataforma activa ahora</span>
                    </div>
                    <ul class="space-y-2.5">
                        <li class="flex items-center gap-3 text-sm font-body">
                            <span class="w-5 h-5 rounded-full bg-plai-magenta/20 flex items-center justify-center flex-shrink-0">
                                <svg aria-hidden="true" class="w-3 h-3 text-plai-magenta" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 14.5v-9l6 4.5-6 4.5z"/></svg>
                            </span>
                            <span class="text-gray-300">GEMA publicó en Instagram · <span class="text-white/50">Clinica Dentauro</span></span>
                            <span class="text-gray-500 text-xs ml-auto whitespace-nowrap">recientemente</span>
                        </li>
                        <li class="flex items-center gap-3 text-sm font-body">
                            <span class="w-5 h-5 rounded-full bg-plai-purple/20 flex items-center justify-center flex-shrink-0">
                                <svg aria-hidden="true" class="w-3 h-3 text-plai-purple" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
                            </span>
                            <span class="text-gray-300">ERI respondió consulta — <span class="text-plai-cyan font-semibold">agendó cita</span></span>
                            <span class="text-gray-500 text-xs ml-auto whitespace-nowrap">recientemente</span>
                        </li>
                        <li class="flex items-center gap-3 text-sm font-body">
                            <span class="w-5 h-5 rounded-full bg-plai-cyan/20 flex items-center justify-center flex-shrink-0">
                                <svg aria-hidden="true" class="w-3 h-3 text-plai-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                            </span>
                            <span class="text-gray-300">3 posts aprobados y programados esta mañana</span>
                            <span class="text-gray-500 text-xs ml-auto whitespace-nowrap">recientemente</span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    .hero-bg {
        background: linear-gradient(135deg, #0a0a14, #0f1029, #0a0a14);
        background-size: 200% 200%;
        animation: gradient-shift 10s ease infinite;
    }
    @keyframes gradient-shift {
        0%, 100% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
    }
    @keyframes glow-pulse {
        0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
        50% { opacity: 0.8; transform: translate(-50%, -50%) scale(1.05); }
    }
    .animate-glow { animation: glow-pulse 6s ease-in-out infinite; }

    /* Disable costly animations on mobile */
    @media (max-width: 768px) {
        .hero-bg { animation: none; }
        .animate-glow { animation: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .hero-bg, .animate-glow { animation: none; }
    }
</style>
