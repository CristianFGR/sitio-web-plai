---
// Hero.astro
---
<section class="relative w-full min-h-screen pt-40 pb-20 overflow-hidden bg-gradient-to-br from-[#fff0f5] via-[#e6f4ff] to-[#e0ffff]">

    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-white to-transparent transform translate-y-2 pointer-events-none z-10"></div>
    <svg class="absolute bottom-0 w-full h-auto text-white fill-current z-10" viewBox="0 0 1440 100" preserveAspectRatio="none">
        <path d="M0,100 C480,0 960,0 1440,100 Z"></path>
    </svg>

    <div class="container mx-auto px-4 h-full">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center h-full relative z-20 mt-10 md:mt-20">

            <!-- Left Column: Copy -->
            <div class="flex flex-col items-start pr-0 lg:pr-12">
                <p class="text-plai-primary font-bold tracking-wider uppercase text-sm mb-4 font-body">Automatización y optimización para eCommerce y PYMEs</p>
                <h1 class="text-5xl md:text-6xl lg:text-[4.5rem] font-heading font-black text-plai-dark mb-6 leading-tight tracking-tight">
                    Ponle <span class="text-plai-primary">PLAI</span> <br class="hidden sm:block" />
                    a tu empresa
                </h1>

                <p class="text-base text-plai-text font-body mb-8 max-w-2xl leading-relaxed">
                    Chatbots con memoria real. Redes sociales autónomas. Asesoría en medios de pago. Sin promesas, solo sistemas funcionando.
                </p>

                <div class="w-full flex justify-start">
                    <a href="#contacto" class="bg-plai-primary hover:bg-blue-700 active:bg-blue-800 text-white px-8 py-3.5 rounded-full font-bold text-base shadow-[0_8px_20px_rgba(0,100,255,0.3)] hover:shadow-[0_12px_25px_rgba(0,100,255,0.4)] transition-all transform hover:-translate-y-0.5">
                        Conversemos
                    </a>
                </div>
            </div>

            <!-- Right Column: Images / Graphics -->
            <div class="relative w-full h-[350px] sm:h-[450px] lg:h-[500px] mt-12 lg:mt-0 block">
                <div class="absolute inset-0 z-0 flex items-center justify-center opacity-30 transform translate-x-8 lg:translate-x-12 translate-y-12 lg:translate-y-24">
                     <svg width="240" height="240" fill="none" viewBox="0 0 240 240" class="w-[150px] sm:w-[200px] lg:w-[240px]">
                        <pattern id="dot-pattern" x="0" y="0" width="24" height="24" patternUnits="userSpaceOnUse">
                            <circle cx="2" cy="2" r="2" fill="#00d084"></circle>
                        </pattern>
                        <rect width="240" height="240" fill="url(#dot-pattern)"></rect>
                    </svg>
                </div>

                <img
                    src={import.meta.env.BASE_URL + "/images/session-acquisition.webp"}
                    alt="Dashboard de adquisición de sesiones PLAI"
                    class="absolute bottom-4 right-0 w-[75%] rounded-2xl shadow-xl z-10 transform translate-x-4"
                />

                <img
                    src={import.meta.env.BASE_URL + "/images/total-sale.webp"}
                    alt="Dashboard de ventas totales PLAI"
                    class="absolute top-4 left-4 w-[65%] rounded-2xl shadow-2xl z-20 border border-white/50"
                />
            </div>

        </div>
    </div>
</section>
