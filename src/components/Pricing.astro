---
// Pricing.astro — SaaS pricing with toggle, 3-col main + AMP add-on
---
<section id="pricing" class="py-24 bg-plai-black relative overflow-hidden">
    <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-[radial-gradient(circle,rgba(0,100,255,0.07)_0%,transparent_70%)] pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-[400px] h-[400px] bg-[radial-gradient(circle,rgba(0,201,183,0.05)_0%,transparent_70%)] pointer-events-none"></div>

    <div class="container mx-auto px-4 relative z-10">

        <!-- Header + Toggle -->
        <div class="text-center mb-14" data-animate>
            <h2 class="text-3xl md:text-5xl font-heading font-bold text-white mb-4">Planes y Soluciones</h2>
            <p class="text-lg text-gray-300 font-body max-w-xl mx-auto">
                Activa tu suscripción y opera desde el primer día. Solicita tu demo y te entregamos el detalle de precios.
            </p>
        </div>

        <!-- 3 Main SaaS plans -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto mb-8" data-animate data-animate-stagger>

            <!-- GEMA -->
            <div class="bg-white/[0.06] backdrop-blur-sm p-7 rounded-2xl border border-white/10 hover:border-plai-magenta/30 hover:-translate-y-1 transition-all duration-300 flex flex-col">
                <div class="mb-6">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="w-2 h-2 rounded-full bg-plai-magenta"></span>
                        <span class="text-plai-magenta font-heading font-black text-xs tracking-widest uppercase">GEMA</span>
                    </div>
                    <h3 class="text-xl font-bold text-white font-heading mb-3">Marketing Automatizado</h3>
                    <div class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-gray-300 text-sm font-body px-4 py-1.5 rounded-full mb-3">
                        <svg aria-hidden="true" class="w-3.5 h-3.5 text-plai-magenta" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/></svg>
                        Consultar precio
                    </div>
                    <p class="text-gray-500 text-xs font-body">Sin permanencia mínima</p>
                </div>

                <ul class="space-y-2.5 mb-8 flex-1">
                    {[
                        "Dashboard de contenido",
                        "Calendario anual con IA",
                        "Publicación automática",
                        "Instagram + Facebook + LinkedIn",
                        "Generación de imágenes con IA",
                        "Revisión por diseñador",
                        "Métricas de alcance",
                        "Backoffice PLAI incluido",
                    ].map(f => (
                        <li class="flex items-start gap-2.5 text-gray-300 font-body text-sm">
                            <svg aria-hidden="true" class="w-4 h-4 text-plai-magenta flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            {f}
                        </li>
                    ))}
                </ul>

                <a href="#contacto" class="block text-center bg-white/10 hover:bg-plai-magenta border border-white/15 hover:border-plai-magenta text-white px-6 py-3 rounded-xl font-bold font-body text-sm transition-all duration-300">
                    Solicitar demo
                </a>
            </div>

            <!-- Plan PLAI Suite — featured -->
            <div class="bg-gradient-to-b from-plai-primary to-plai-dark p-7 rounded-2xl border-2 border-plai-secondary shadow-[0_0_50px_rgba(0,100,255,0.4)] flex flex-col relative -mt-4 -mb-4">
                <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-plai-cyan text-plai-black text-xs font-bold font-body px-5 py-1.5 rounded-full uppercase tracking-wider whitespace-nowrap shadow-lg">
                    Más popular
                </div>
                <div class="mb-6 mt-3">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="w-2 h-2 rounded-full bg-plai-cyan"></span>
                        <span class="text-plai-cyan font-heading font-black text-xs tracking-widest uppercase">Plan PLAI Suite</span>
                    </div>
                    <h3 class="text-xl font-bold text-white font-heading mb-3">GEMA + ERI completo</h3>
                    <div class="inline-flex items-center gap-2 bg-white/20 border border-white/25 text-white text-sm font-body px-4 py-1.5 rounded-full mb-3">
                        <svg aria-hidden="true" class="w-3.5 h-3.5 text-plai-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/></svg>
                        Consultar precio
                    </div>
                    <p class="text-white/50 text-xs font-body">Plan más completo · GEMA + ERI unidos</p>
                </div>

                <ul class="space-y-2.5 mb-8 flex-1">
                    {[
                        "Todo GEMA incluido",
                        "Todo ERI incluido",
                        "Dashboard unificado",
                        "Onboarding dedicado (2h)",
                        "Soporte prioritario",
                        "Analytics integradas",
                        "Acceso anticipado a funciones",
                        "Backoffice PLAI incluido",
                    ].map(f => (
                        <li class="flex items-start gap-2.5 text-white font-body text-sm">
                            <svg aria-hidden="true" class="w-4 h-4 text-plai-cyan flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            {f}
                        </li>
                    ))}
                </ul>

                <a href="#contacto" class="block text-center bg-white text-plai-primary hover:bg-plai-cyan hover:text-plai-black px-6 py-3.5 rounded-xl font-bold font-body text-sm transition-all duration-300 shadow-lg">
                    Empezar ahora
                </a>
            </div>

            <!-- ERI -->
            <div class="bg-white/[0.06] backdrop-blur-sm p-7 rounded-2xl border border-white/10 hover:border-plai-purple/30 hover:-translate-y-1 transition-all duration-300 flex flex-col">
                <div class="mb-6">
                    <div class="flex items-center gap-2 mb-2">
                        <span class="w-2 h-2 rounded-full bg-plai-purple"></span>
                        <span class="text-plai-purple font-heading font-black text-xs tracking-widest uppercase">ERI</span>
                    </div>
                    <h3 class="text-xl font-bold text-white font-heading mb-3">Agente IA de Ventas</h3>
                    <div class="inline-flex items-center gap-2 bg-white/10 border border-white/15 text-gray-300 text-sm font-body px-4 py-1.5 rounded-full mb-3">
                        <svg aria-hidden="true" class="w-3.5 h-3.5 text-plai-purple" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 01-2.555-.337A5.972 5.972 0 015.41 20.97a5.969 5.969 0 01-.474-.065 4.48 4.48 0 00.978-2.025c.09-.457-.133-.901-.467-1.226C3.93 16.178 3 14.189 3 12c0-4.556 4.03-8.25 9-8.25s9 3.694 9 8.25z"/></svg>
                        Consultar precio
                    </div>
                    <p class="text-gray-500 text-xs font-body">Sin permanencia mínima</p>
                </div>

                <ul class="space-y-2.5 mb-8 flex-1">
                    {[
                        "Agente IA activo 24/7",
                        "Integración WhatsApp Business",
                        "Integración Shopify",
                        "Motor de sentimientos",
                        "Guardrails cognitivos",
                        "Booking Engine 360",
                        "Recuperación de carrito",
                        "Backoffice PLAI incluido",
                    ].map(f => (
                        <li class="flex items-start gap-2.5 text-gray-300 font-body text-sm">
                            <svg aria-hidden="true" class="w-4 h-4 text-plai-purple flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                            {f}
                        </li>
                    ))}
                </ul>

                <a href="#contacto" class="block text-center bg-white/10 hover:bg-plai-purple border border-white/15 hover:border-plai-purple text-white px-6 py-3 rounded-xl font-bold font-body text-sm transition-all duration-300">
                    Solicitar demo
                </a>
            </div>
        </div>

        <!-- Bottom note -->
        <p class="text-center text-gray-400 font-body text-sm mb-12" data-animate>
            Todos los planes incluyen acceso al backoffice PLAI · Soporte por email · Sin costos ocultos
        </p>

        <!-- AMP — Add-on separado -->
        <div class="max-w-5xl mx-auto" data-animate>
            <div class="bg-white/[0.03] border border-white/[0.08] rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center gap-6 hover:border-plai-accent/30 transition-colors duration-300">
                <div class="flex-shrink-0">
                    <div class="w-12 h-12 bg-plai-accent/15 rounded-xl flex items-center justify-center">
                        <svg aria-hidden="true" class="w-6 h-6 text-plai-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z"/>
                        </svg>
                    </div>
                </div>
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="text-plai-accent font-heading font-black text-xs tracking-widest uppercase">AMP · Add-on</span>
                        <span class="bg-plai-accent/15 text-plai-accent text-xs font-bold px-2.5 py-0.5 rounded-full border border-plai-accent/25">Complemento opcional</span>
                    </div>
                    <h3 class="text-lg font-bold text-white font-heading mb-1">Asesoría en Medios de Pago</h3>
                    <p class="text-gray-400 font-body text-sm leading-relaxed max-w-2xl">
                        Auditoría de comisiones, tasa de aprobación y estructura de checkout. Proyecto a medida según volumen y proveedores actuales. Empieza con diagnóstico gratuito.
                    </p>
                    <div class="flex flex-wrap gap-4 mt-3">
                        {["Diagnóstico sin costo", "Auditoría de comisiones", "Revisión de checkout", "Implementación incluida"].map(f => (
                            <span class="flex items-center gap-1.5 text-gray-400 text-xs font-body">
                                <svg aria-hidden="true" class="w-3.5 h-3.5 text-plai-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                                {f}
                            </span>
                        ))}
                    </div>
                </div>
                <a href="#contacto" class="flex-shrink-0 bg-plai-accent/15 hover:bg-plai-accent/30 border border-plai-accent/30 text-plai-accent px-6 py-3 rounded-xl font-bold font-body text-sm transition-all duration-300 whitespace-nowrap">
                    Diagnóstico gratuito
                </a>
            </div>
        </div>
    </div>
</section>

