---
// WebchatWidget.astro — Widget de webchat PLAI (ERI)
// Conectado a eri.plai.cl
---

<script
    src="https://eri.plai.cl/static/js/webchat-widget.js"
    data-api-key="ff014b8d-b0e1-46d5-abc1-3f8861df6c75"
    data-api-url="https://eri.plai.cl"
    data-title="PLAI Asistente"
    data-color="#0064ff">
</script>

<script>
    // Reposicionar widget arriba del WhatsApp (el JS inyecta estilos inline)
    function repositionWidget() {
        const btn = document.getElementById('theia-widget-btn');
        const box = document.getElementById('theia-widget-box');
        if (btn) btn.style.bottom = '96px';
        if (box) box.style.bottom = '160px';
    }
    const observer = new MutationObserver(() => {
        if (document.getElementById('theia-widget-btn')) {
            repositionWidget();
            observer.disconnect();
        }
    });
    observer.observe(document.body, { childList: true, subtree: true });
    setTimeout(repositionWidget, 1000);
</script>
