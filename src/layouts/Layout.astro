---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: string;
	url?: string;
}

const {
	title,
	description,
	image = "https://plai.cl/images/logoplai_2.png",
	url = "https://plai.cl/"
} = Astro.props;
---

<!doctype html>
<html lang="es" class="no-js">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
		<link rel="icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<link rel="canonical" href={url} />

		<!-- Open Graph / SEO Social -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={url} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={image} />
		<meta property="og:locale" content="es_CL" />
		<meta property="og:site_name" content="PLAI" />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={url} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		
		<!-- Google tag (gtag.js) — descomentar cuando se tenga el Measurement ID real
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
		<script>
		  window.dataLayer = window.dataLayer || [];
		  function gtag(){dataLayer.push(arguments);}
		  gtag('js', new Date());
		  gtag('config', 'G-XXXXXXXXXX');
		</script>
		-->
		
		<title>{title}</title>

		<!-- Datos estructurados -->
		<script type="application/ld+json" is:inline>
		[
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				"@id": "https://plai.cl/#organization",
				"name": "PLAI",
				"url": "https://plai.cl",
				"logo": "https://plai.cl/images/logoplai_2.png",
				"description": "Plataforma SaaS chilena de automatización con inteligencia artificial para eCommerce y PYMEs. Software propio con backoffice, agente IA de ventas 24/7 y marketing autónomo.",
				"email": "plai@plai.cl",
				"areaServed": { "@type": "Country", "name": "Chile" },
				"knowsLanguage": "es",
				"priceRange": "$$",
				"sameAs": [
					"https://www.instagram.com/plai.cl/",
					"https://www.linkedin.com/company/plai-cl/"
				]
			},
			{
				"@context": "https://schema.org",
				"@type": "Service",
				"@id": "https://plai.cl/#amp",
				"name": "AMP — Asesoría en Medios de Pago",
				"description": "Revisión y optimización de la estructura de pagos de tu eCommerce, enfocado en mejorar la tasa de aprobación, reducir comisiones y maximizar el margen por transacción.",
				"provider": { "@id": "https://plai.cl/#organization" },
				"areaServed": { "@type": "Country", "name": "Chile" },
				"serviceType": "Asesoría en medios de pago eCommerce"
			},
			{
				"@context": "https://schema.org",
				"@type": "Service",
				"@id": "https://plai.cl/#gema",
				"name": "GEMA — Generación Experta de Marketing Automatizado",
				"description": "Plan anual de marketing con estrategia, pilares de contenido y calendario comunicacional, listo para ejecutarse de manera 100% automatizada.",
				"provider": { "@id": "https://plai.cl/#organization" },
				"areaServed": { "@type": "Country", "name": "Chile" },
				"serviceType": "Software SaaS de marketing automatizado",
			"applicationCategory": "BusinessApplication",
				"offers": {
					"@type": "Offer",
					"price": "140000",
					"priceCurrency": "CLP"
				}
			},
			{
				"@context": "https://schema.org",
				"@type": "Service",
				"@id": "https://plai.cl/#eri",
				"name": "ERI — Ejecutivo Resolutor Inteligente",
				"description": "Agente de inteligencia artificial que convierte conversaciones en ventas, operando 24/7 sin intervención humana. Se integra con WhatsApp Business y Shopify.",
				"provider": { "@id": "https://plai.cl/#organization" },
				"areaServed": { "@type": "Country", "name": "Chile" },
				"serviceType": "Agente IA SaaS para ventas conversacionales",
				"offers": {
					"@type": "Offer",
					"price": "200000",
					"priceCurrency": "CLP"
				}
			}
		]
		</script>
		
		<!-- Fuentes -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="preload" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" as="style" onload="this.onload=null;this.rel='stylesheet'" />
		<noscript><link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet" /></noscript>
	</head>
	<body class="bg-plai-dark text-white font-body selection:bg-plai-primary selection:text-white">
		<!-- Skip to content — keyboard accessibility (WCAG 2.4.1) -->
		<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:bg-plai-primary focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold focus:shadow-lg">
			Ir al contenido principal
		</a>
		<slot />

		<!-- Global scroll-triggered animation system -->
		<script is:inline>
			(function() {
				document.documentElement.classList.remove('no-js');
				
				var observer = new IntersectionObserver(function(entries) {
					entries.forEach(function(entry) {
						if (entry.isIntersecting) {
							reveal(entry.target);
						}
					});
				}, { threshold: 0.12, rootMargin: '0px' });

				function reveal(el) {
					if (!el.classList.contains('in-view')) {
						el.classList.add('in-view');
						observer.unobserve(el);
					}
				}

				// 1. Observe all elements with data-animate
				var animElements = document.querySelectorAll('[data-animate]');
				animElements.forEach(function(el) {
					observer.observe(el);
				});

				// 2. Rect-check at initialization (Option A)
				function checkVisibilityOnInit() {
					var windowHeight = window.innerHeight;
					animElements.forEach(function(el) {
						var rect = el.getBoundingClientRect();
						// If element is already in the viewport
						if (rect.top < windowHeight && rect.bottom > 0) {
							reveal(el);
						}
					});
				}

				// 3. Reveal elements in target section on hash change / click (Option B)
				function revealSectionByHash(hash) {
					if (!hash) return;
					var targetId = hash.replace('#', '');
					if (!targetId) return;
					var targetSection = document.getElementById(targetId);
					if (targetSection) {
						// Find all animatable elements inside or that are the section itself
						var elementsToReveal = targetSection.querySelectorAll('[data-animate]');
						elementsToReveal.forEach(function(el) {
							reveal(el);
						});
						if (targetSection.hasAttribute('data-animate')) {
							reveal(targetSection);
						}
					}
				}

				// Run rect-check on init
				checkVisibilityOnInit();

				// Run reveal when page loads with a hash
				if (window.location.hash) {
					setTimeout(function() {
						revealSectionByHash(window.location.hash);
					}, 100);
				}

				// Listen for hash changes (e.g. clicking menu items)
				window.addEventListener('hashchange', function() {
					revealSectionByHash(window.location.hash);
				});

				// Also capture clicks on anchor links directly (covers click in case hashchange behaves weirdly)
				document.addEventListener('click', function(e) {
					var anchor = e.target.closest('a');
					if (anchor && anchor.getAttribute('href') && anchor.getAttribute('href').startsWith('#')) {
						var hash = anchor.getAttribute('href');
						revealSectionByHash(hash);
					}
				});
			})();
		</script>

		<style is:global>
			/* Scroll-triggered entrance animations */
			[data-animate] {
				opacity: 0;
				transform: translateY(24px);
				transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1),
				            transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
			}
			[data-animate].in-view {
				opacity: 1;
				transform: translateY(0);
			}

			/* Staggered children */
			[data-animate-stagger] > * {
				opacity: 0;
				transform: translateY(20px);
				transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
				            transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
			}
			[data-animate-stagger].in-view > *:nth-child(1) { transition-delay: 0ms; opacity: 1; transform: translateY(0); }
			[data-animate-stagger].in-view > *:nth-child(2) { transition-delay: 100ms; opacity: 1; transform: translateY(0); }
			[data-animate-stagger].in-view > *:nth-child(3) { transition-delay: 180ms; opacity: 1; transform: translateY(0); }
			[data-animate-stagger].in-view > *:nth-child(4) { transition-delay: 260ms; opacity: 1; transform: translateY(0); }
			[data-animate-stagger].in-view > *:nth-child(5) { transition-delay: 340ms; opacity: 1; transform: translateY(0); }
			[data-animate-stagger].in-view > *:nth-child(6) { transition-delay: 420ms; opacity: 1; transform: translateY(0); }
			[data-animate-stagger].in-view > *:nth-child(n+7) { transition-delay: 500ms; opacity: 1; transform: translateY(0); }

			/* Fallback: show content if JS is disabled */
			html.no-js [data-animate],
			html.no-js [data-animate-stagger] > * {
				opacity: 1 !important;
				transform: none !important;
			}

			/* Hero entrance animations (on load, no scroll needed) */
			@keyframes hero-enter {
				from { opacity: 0; transform: translateY(28px); }
				to   { opacity: 1; transform: translateY(0); }
			}
			.hero-enter-1 { animation: hero-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both; }
			.hero-enter-2 { animation: hero-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both; }
			.hero-enter-3 { animation: hero-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both; }
			.hero-enter-4 { animation: hero-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.55s both; }
			.hero-enter-5 { animation: hero-enter 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.7s both; }
			.hero-enter-img { animation: hero-enter 1s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both; }

			/* Respect reduced motion */
			@media (prefers-reduced-motion: reduce) {
				[data-animate],
				[data-animate-stagger] > *,
				.hero-enter-1, .hero-enter-2, .hero-enter-3,
				.hero-enter-4, .hero-enter-5, .hero-enter-img,
				.animate-ping, .animate-pulse, .animate-glow,
				.animate-spin, .animate-bounce {
					opacity: 1 !important;
					transform: none !important;
					transition: none !important;
					animation: none !important;
				}
			}
		</style>
	</body>
</html>
