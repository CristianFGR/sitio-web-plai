---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Página no encontrada | PLAI" description="La página que buscas no existe.">
	<main class="min-h-screen flex flex-col items-center justify-center bg-plai-dark text-white px-4">
		<h1 class="text-8xl md:text-9xl font-heading font-black text-plai-primary mb-4">404</h1>
		<p class="text-xl md:text-2xl font-body text-gray-300 mb-8 text-center max-w-md">
			La página que buscas no existe o fue movida.
		</p>
		<a
			href={import.meta.env.BASE_URL}
			class="bg-plai-primary hover:bg-blue-700 active:bg-blue-800 text-white px-8 py-3.5 rounded-full font-bold text-base shadow-[0_8px_20px_rgba(0,100,255,0.3)] hover:shadow-[0_12px_25px_rgba(0,100,255,0.4)] transition-all transform hover:-translate-y-0.5"
		>
			Volver al inicio
		</a>
	</main>
</Layout>
