---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lastUpdated = "22 de junio de 2026";
---

<Layout
  title="Política de Privacidad | PLAI — Automatización IA para eCommerce y PYMEs"
  description="Conoce cómo PLAI recopila, usa y protege tu información personal. Política de privacidad conforme a la ley chilena N° 19.628 y buenas prácticas internacionales."
  url="https://plai.cl/politica-de-privacidad"
>
  <Header />

  <main id="main-content" class="bg-plai-dark min-h-screen pt-28 pb-20">

    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <!-- Background gradient -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-0 left-1/4 w-[600px] h-[600px] rounded-full opacity-10 blur-[120px]"
             style="background: radial-gradient(circle, #0064ff 0%, transparent 70%);"></div>
        <div class="absolute bottom-0 right-1/4 w-[400px] h-[400px] rounded-full opacity-8 blur-[100px]"
             style="background: radial-gradient(circle, #7c3aed 0%, transparent 70%);"></div>
      </div>

      <div class="container mx-auto px-4 py-16 relative z-10">
        <div class="max-w-3xl mx-auto text-center" data-animate>
          <!-- Badge -->
          <div class="inline-flex items-center gap-2 bg-plai-primary/10 border border-plai-primary/30 text-plai-secondary px-4 py-2 rounded-full text-sm font-medium mb-6 font-body">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            Documento Legal
          </div>

          <h1 class="font-heading font-black text-4xl md:text-5xl text-white mb-4 leading-tight">
            Política de <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(135deg, #0064ff, #00a7ff);">Privacidad</span>
          </h1>
          <p class="text-gray-400 font-body text-lg max-w-xl mx-auto">
            En PLAI nos comprometemos a proteger y respetar tu privacidad. Este documento explica cómo tratamos tu información personal.
          </p>
          <p class="text-gray-500 font-body text-sm mt-4">
            Última actualización: <span class="text-gray-300">{lastUpdated}</span>
          </p>
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <hr class="border-gray-800" />
      </div>
    </div>

    <!-- Content -->
    <section class="container mx-auto px-4 py-12">
      <div class="max-w-3xl mx-auto space-y-12 font-body">

        <!-- 1. Responsable -->
        <div data-animate class="privacy-section">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5"
                 style="background: linear-gradient(135deg, #0064ff22, #0064ff44);">
              <svg class="w-5 h-5 text-plai-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-2 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
            </div>
            <div>
              <h2 class="font-heading font-bold text-2xl text-white mb-3">1. Responsable del tratamiento</h2>
              <p class="text-gray-300 leading-relaxed mb-3">
                El responsable del tratamiento de tus datos personales es:
              </p>
              <div class="bg-white/5 border border-white/10 rounded-2xl p-5 space-y-2">
                <p class="text-white font-semibold">PLAI — Automatización e Inteligencia Artificial</p>
                <p class="text-gray-300">Sitio web: <a href="https://plai.cl" class="text-plai-secondary hover:underline">https://plai.cl</a></p>
                <p class="text-gray-300">Email de contacto: <a href="mailto:plai@plai.cl" class="text-plai-secondary hover:underline">plai@plai.cl</a></p>
                <p class="text-gray-300">País de operación: Chile</p>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Datos recopilados -->
        <div data-animate class="privacy-section">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5"
                 style="background: linear-gradient(135deg, #7c3aed22, #7c3aed44);">
              <svg class="w-5 h-5 text-plai-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
              </svg>
            </div>
            <div class="flex-1">
              <h2 class="font-heading font-bold text-2xl text-white mb-3">2. Información que recopilamos</h2>
              <p class="text-gray-300 leading-relaxed mb-4">
                Recopilamos información en las siguientes categorías:
              </p>

              <div class="space-y-4">
                <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
                  <h3 class="text-white font-semibold mb-2 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-plai-primary inline-block"></span>
                    Información que tú nos proporcionas
                  </h3>
                  <ul class="text-gray-300 space-y-1 pl-4 list-disc list-outside marker:text-plai-primary">
                    <li>Nombre y apellido</li>
                    <li>Dirección de correo electrónico</li>
                    <li>Número de teléfono (WhatsApp u otro)</li>
                    <li>Nombre de tu empresa o negocio</li>
                    <li>Mensaje o consulta enviada a través de nuestros formularios de contacto</li>
                  </ul>
                </div>

                <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
                  <h3 class="text-white font-semibold mb-2 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-plai-secondary inline-block"></span>
                    Información recopilada automáticamente
                  </h3>
                  <ul class="text-gray-300 space-y-1 pl-4 list-disc list-outside marker:text-plai-secondary">
                    <li>Dirección IP y datos de geolocalización aproximada</li>
                    <li>Tipo de navegador y sistema operativo</li>
                    <li>Páginas visitadas, tiempo de permanencia y comportamiento de navegación</li>
                    <li>Fuente de tráfico (búsqueda orgánica, redes sociales, acceso directo)</li>
                    <li>Datos de cookies y tecnologías de seguimiento similares</li>
                  </ul>
                </div>

                <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
                  <h3 class="text-white font-semibold mb-2 flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-plai-cyan inline-block"></span>
                    Datos de interacciones con el chatbot / asistente IA
                  </h3>
                  <ul class="text-gray-300 space-y-1 pl-4 list-disc list-outside marker:text-plai-cyan">
                    <li>Contenido de las conversaciones iniciadas a través del widget de chat en nuestro sitio</li>
                    <li>Consultas sobre productos, servicios o soporte técnico</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Finalidad -->
        <div data-animate class="privacy-section">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5"
                 style="background: linear-gradient(135deg, #00c9b722, #00c9b744);">
              <svg class="w-5 h-5 text-plai-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="flex-1">
              <h2 class="font-heading font-bold text-2xl text-white mb-3">3. Finalidad del tratamiento</h2>
              <p class="text-gray-300 leading-relaxed mb-4">
                Utilizamos tu información personal para los siguientes propósitos:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {[
                  { icon: "💬", text: "Responder a tus consultas y solicitudes de contacto" },
                  { icon: "📦", text: "Entregar los servicios contratados (chatbots, marketing, asesoría)" },
                  { icon: "📊", text: "Analizar el uso del sitio web y mejorar la experiencia" },
                  { icon: "📣", text: "Enviar comunicaciones comerciales relevantes (con tu consentimiento)" },
                  { icon: "🔒", text: "Cumplir obligaciones legales aplicables en Chile" },
                  { icon: "🛡️", text: "Prevenir fraudes y garantizar la seguridad del sitio" },
                ].map(item => (
                  <div class="flex items-start gap-3 bg-white/5 border border-white/10 rounded-xl p-4">
                    <span class="text-xl">{item.icon}</span>
                    <p class="text-gray-300 text-sm leading-relaxed">{item.text}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <!-- 4. Base legal -->
        <div data-animate class="privacy-section">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5"
                 style="background: linear-gradient(135deg, #c8a84e22, #c8a84e44);">
              <svg class="w-5 h-5 text-plai-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3"/>
              </svg>
            </div>
            <div class="flex-1">
              <h2 class="font-heading font-bold text-2xl text-white mb-3">4. Base legal del tratamiento</h2>
              <p class="text-gray-300 leading-relaxed mb-4">
                El tratamiento de tus datos personales se realiza sobre la base de las siguientes legitimaciones, de acuerdo a la <strong class="text-white">Ley N° 19.628</strong> sobre Protección de la Vida Privada de Chile:
              </p>
              <div class="space-y-3">
                <div class="flex gap-3 bg-white/5 border border-white/10 rounded-xl p-4">
                  <span class="text-plai-accent font-bold text-lg">→</span>
                  <div>
                    <p class="text-white font-semibold text-sm">Consentimiento</p>
                    <p class="text-gray-400 text-sm">Para el envío de comunicaciones de marketing y el uso de cookies no esenciales.</p>
                  </div>
                </div>
                <div class="flex gap-3 bg-white/5 border border-white/10 rounded-xl p-4">
                  <span class="text-plai-accent font-bold text-lg">→</span>
                  <div>
                    <p class="text-white font-semibold text-sm">Ejecución de un contrato</p>
                    <p class="text-gray-400 text-sm">Para prestar los servicios contratados y responder a solicitudes previas a la contratación.</p>
                  </div>
                </div>
                <div class="flex gap-3 bg-white/5 border border-white/10 rounded-xl p-4">
                  <span class="text-plai-accent font-bold text-lg">→</span>
                  <div>
                    <p class="text-white font-semibold text-sm">Interés legítimo</p>
                    <p class="text-gray-400 text-sm">Para analizar el rendimiento del sitio, prevenir fraudes y mejorar nuestros servicios.</p>
                  </div>
                </div>
                <div class="flex gap-3 bg-white/5 border border-white/10 rounded-xl p-4">
                  <span class="text-plai-accent font-bold text-lg">→</span>
                  <div>
                    <p class="text-white font-semibold text-sm">Obligación legal</p>
                    <p class="text-gray-400 text-sm">Cuando la ley chilena u otra norma aplicable así lo exija.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 5. Cookies y tecnologías de seguimiento -->
        <div data-animate class="privacy-section">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5"
                 style="background: linear-gradient(135deg, #e855a022, #e855a044);">
              <svg class="w-5 h-5 text-plai-magenta" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 3H5a2 2 0 00-2 2v4m6-6h10a2 2 0 012 2v4M9 3v18m0 0h10a2 2 0 002-2V9M9 21H5a2 2 0 01-2-2V9m0 0h18"/>
              </svg>
            </div>
            <div class="flex-1">
              <h2 class="font-heading font-bold text-2xl text-white mb-3">5. Cookies y tecnologías de seguimiento</h2>
              <p class="text-gray-300 leading-relaxed mb-4">
                Nuestro sitio puede utilizar cookies y tecnologías similares para mejorar tu experiencia de navegación y analizar el tráfico. Los tipos de cookies que podemos usar son:
              </p>
              <div class="space-y-3 mb-4">
                <div class="bg-white/5 border border-white/10 rounded-xl p-4">
                  <p class="text-white font-semibold text-sm mb-1">Cookies esenciales</p>
                  <p class="text-gray-400 text-sm">Necesarias para el funcionamiento básico del sitio. No pueden desactivarse.</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-xl p-4">
                  <p class="text-white font-semibold text-sm mb-1">Cookies analíticas (Google Analytics)</p>
                  <p class="text-gray-400 text-sm">Nos permiten entender cómo los visitantes interactúan con el sitio, cuáles páginas visitan y cómo llegan a nosotros. Los datos se procesan de forma agregada y anónima.</p>
                </div>
                <div class="bg-white/5 border border-white/10 rounded-xl p-4">
                  <p class="text-white font-semibold text-sm mb-1">Cookies de marketing</p>
                  <p class="text-gray-400 text-sm">Pueden utilizarse para mostrarte publicidad relevante en otras plataformas. Solo se activan con tu consentimiento.</p>
                </div>
              </div>
              <div class="bg-plai-primary/10 border border-plai-primary/30 rounded-xl p-4">
                <p class="text-plai-secondary text-sm">
                  <strong>Tu control:</strong> Puedes gestionar tus preferencias de cookies en cualquier momento desde la configuración de tu navegador. Ten en cuenta que desactivar ciertas cookies puede afectar la funcionalidad del sitio.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 6. Compartición de datos -->
        <div data-animate class="privacy-section">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5"
                 style="background: linear-gradient(135deg, #0064ff22, #00a7ff44);">
              <svg class="w-5 h-5 text-plai-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
              </svg>
            </div>
            <div class="flex-1">
              <h2 class="font-heading font-bold text-2xl text-white mb-3">6. Compartición de datos con terceros</h2>
              <p class="text-gray-300 leading-relaxed mb-4">
                <strong class="text-white">No vendemos tu información personal.</strong> Sin embargo, podemos compartir datos con los siguientes proveedores de servicios de confianza, quienes actúan como encargados del tratamiento en nuestro nombre:
              </p>
              <div class="space-y-3 mb-4">
                {[
                  { name: "Google Analytics / Google Tag Manager", purpose: "Análisis de tráfico web y comportamiento de usuarios", policy: "https://policies.google.com/privacy" },
                  { name: "Firebase (Google Cloud)", purpose: "Alojamiento del sitio web y base de datos de contactos", policy: "https://firebase.google.com/support/privacy" },
                  { name: "WhatsApp Business API", purpose: "Gestión de conversaciones y comunicación con clientes", policy: "https://www.whatsapp.com/legal/privacy-policy" },
                  { name: "Make / n8n (Automatización)", purpose: "Automatización de flujos de trabajo y marketing", policy: "https://www.make.com/en/privacy-notice" },
                ].map(provider => (
                  <div class="bg-white/5 border border-white/10 rounded-xl p-4">
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="text-white font-semibold text-sm">{provider.name}</p>
                        <p class="text-gray-400 text-sm mt-1">{provider.purpose}</p>
                      </div>
                      <a href={provider.policy} target="_blank" rel="noopener noreferrer"
                         class="text-plai-secondary text-xs hover:underline flex-shrink-0 mt-1">
                        Ver política →
                      </a>
                    </div>
                  </div>
                ))}
              </div>
              <p class="text-gray-400 text-sm">
                También podemos divulgar tus datos cuando sea requerido por ley, orden judicial u autoridad competente chilena.
              </p>
            </div>
          </div>
        </div>

        <!-- 7. Retención de datos -->
        <div data-animate class="privacy-section">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5"
                 style="background: linear-gradient(135deg, #7c3aed22, #7c3aed44);">
              <svg class="w-5 h-5 text-plai-purple" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div class="flex-1">
              <h2 class="font-heading font-bold text-2xl text-white mb-3">7. Retención de datos</h2>
              <p class="text-gray-300 leading-relaxed mb-4">
                Conservamos tu información personal solo el tiempo necesario para cumplir los fines descritos en esta política, salvo que la ley exija un período mayor:
              </p>
              <div class="space-y-3">
                <div class="flex gap-3 bg-white/5 border border-white/10 rounded-xl p-4">
                  <div class="text-plai-purple font-bold">📋</div>
                  <div>
                    <p class="text-white font-semibold text-sm">Datos de formularios de contacto</p>
                    <p class="text-gray-400 text-sm">Hasta 2 años desde la última interacción, o hasta que solicites su eliminación.</p>
                  </div>
                </div>
                <div class="flex gap-3 bg-white/5 border border-white/10 rounded-xl p-4">
                  <div class="text-plai-purple font-bold">📊</div>
                  <div>
                    <p class="text-white font-semibold text-sm">Datos analíticos (Google Analytics)</p>
                    <p class="text-gray-400 text-sm">14 meses en Google Analytics (configuración predeterminada).</p>
                  </div>
                </div>
                <div class="flex gap-3 bg-white/5 border border-white/10 rounded-xl p-4">
                  <div class="text-plai-purple font-bold">📄</div>
                  <div>
                    <p class="text-white font-semibold text-sm">Datos de clientes activos</p>
                    <p class="text-gray-400 text-sm">Durante la vigencia del contrato de servicios y por el período legal posterior exigido en Chile.</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 8. Tus derechos -->
        <div data-animate class="privacy-section">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5"
                 style="background: linear-gradient(135deg, #00c9b722, #00c9b744);">
              <svg class="w-5 h-5 text-plai-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
            </div>
            <div class="flex-1">
              <h2 class="font-heading font-bold text-2xl text-white mb-3">8. Tus derechos</h2>
              <p class="text-gray-300 leading-relaxed mb-4">
                De acuerdo a la Ley N° 19.628 y mejores prácticas internacionales, tienes los siguientes derechos sobre tus datos personales:
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
                {[
                  { right: "Acceso", desc: "Conocer qué datos tuyos tratamos y cómo los usamos." },
                  { right: "Rectificación", desc: "Solicitar la corrección de datos incorrectos o incompletos." },
                  { right: "Eliminación", desc: "Pedir la eliminación de tus datos cuando no sean necesarios." },
                  { right: "Oposición", desc: "Oponerte al tratamiento de tus datos para fines de marketing." },
                  { right: "Portabilidad", desc: "Recibir tus datos en un formato estructurado y legible." },
                  { right: "Limitación", desc: "Solicitar la restricción del tratamiento en ciertos casos." },
                ].map(item => (
                  <div class="bg-white/5 border border-white/10 rounded-xl p-4">
                    <p class="text-plai-cyan font-semibold text-sm mb-1">{item.right}</p>
                    <p class="text-gray-400 text-sm">{item.desc}</p>
                  </div>
                ))}
              </div>
              <div class="bg-plai-primary/10 border border-plai-primary/30 rounded-xl p-5">
                <p class="text-white font-semibold mb-2">¿Cómo ejercer tus derechos?</p>
                <p class="text-gray-300 text-sm leading-relaxed">
                  Puedes ejercer cualquiera de estos derechos enviando una solicitud por correo electrónico a <a href="mailto:plai@plai.cl" class="text-plai-secondary hover:underline font-semibold">plai@plai.cl</a> indicando tu nombre, el derecho que deseas ejercer y los datos a los que se refiere tu solicitud. Responderemos en un plazo máximo de <strong class="text-white">30 días hábiles</strong>.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- 9. Seguridad -->
        <div data-animate class="privacy-section">
          <div class="flex items-start gap-4 mb-4">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 mt-0.5"
                 style="background: linear-gradient(135deg, #0064ff22, #0064ff44);">
              <svg class="w-5 h-5 text-plai-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
